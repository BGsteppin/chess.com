# Which game mode to run:
#   computer = play against chess.com's built-in bots (no humans, no ToS issues)
#   live     = play rated games against humans (NOT USED - requires Komodo/Stockfish backend)
GAME_TYPE=computer

# Bot strength on chess.com's slider (1-30+). 24 is roughly 1800 ELO; 1 is weakest.
OPPONENT_STRENGTH=15

# Time control picked from the "Custom" dropdown. Must match an option label
# on https://www.chess.com/play/computer (e.g. "10 min", "5 | 5", "Unlimited").
DURATION=Unlimited

# Internal ports used by the frontend worker.
SERVER_PORT=3000
SOCKET_PORT=3001

# Chrome executable. Leave unset to use puppeteer's bundled Chromium.
# macOS: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux: /usr/bin/google-chrome   (or omit to let puppeteer pick)
# CHROME_PATH=

# Reuse a Chrome profile so your chess.com login survives across runs.
# Point this at a *dedicated* dir (NOT your main profile - puppeteer will own it).
# macOS example: /Users/you/.chess-bot-profile
# USER_DATA_DIR=

# Puppeteer launch flags. Keep these for the GUI/devtools flow the bot relies on.
HEADLESS=false
DEVTOOLS=true
